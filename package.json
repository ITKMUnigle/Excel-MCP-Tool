{
    "name": "@itkmoon/excel-mcp",
    "version": "1.0.1",
    "description": "A powerful MCP tool for Excel file operations with read, write, and formatting capabilities",
    "main": "dist/index.js",
    "bin": {
        "excel-mcp": "dist/index.js"
    },
    "type": "module",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "start": "node dist/index.js",
        "start:stdio": "node dist/index.js --stdio",
        "start:http": "node dist/index.js --http",
        "lint": "eslint src/**/*.ts",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "mcp",
        "excel",
        "spreadsheet",
        "xlsx",
        "xls",
        "ai",
        "claude",
        "cursor",
        "trae",
        "model-context-protocol"
    ],
    "author": "ITKMUnigle",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.4",
        "exceljs": "^4.4.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.11.16",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "eslint": "^8.56.0",
        "typescript": "^5.3.3"
    }
}